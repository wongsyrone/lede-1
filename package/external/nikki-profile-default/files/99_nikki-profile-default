#!/bin/sh

[ "$(uci -q get nikki.config)" = config ] || exit 0
[ "$(uci -q get nikki.mixin)" = mixin ] || exit 0

bypass='nikki.@router_access_control[0]'
users=$(uci -q get "$bypass.user")
cgroups=$(uci -q get "$bypass.cgroup")

# Extend the upstream scoped rule: a cgroup-only rule can become a wildcard if Trojan is absent.
case " $users " in *" dnsmasq "*) ;; *) exit 0 ;; esac
case " $cgroups " in *" services/zerotier "*) ;; *) exit 0 ;; esac
[ "$(uci -q get "$bypass.enabled")" = 1 ] || exit 0
case "$(uci -q get "$bypass.dns")" in 0|1) ;; *) exit 0 ;; esac
[ "$(uci -q get "$bypass.proxy")" = 0 ] || exit 0

changed=0
# dnsmasq and native clients use the same encrypted resolver; their business sockets stay direct.
if [ "$(uci -q get "$bypass.dns")" != 1 ]; then
    uci set "$bypass.dns=1" || exit 1
    changed=1
fi
case " $cgroups " in
    *" services/trojan "*) ;;
    *) uci add_list "$bypass.cgroup=services/trojan" || exit 1; changed=1 ;;
esac

profile=$(uci -q get nikki.config.profile)
select_default=0
case "$profile" in
    '') select_default=1 ;;
    subscription:subscription)
        url=$(uci -q get nikki.subscription.url)
        case "$url" in ''|http://example.com/default.yaml) select_default=1 ;; esac
        ;;
esac

# Never replace an enabled or user-selected profile, even if its file is temporarily unavailable.
if [ "$select_default" = 1 ] && [ "$(uci -q get nikki.config.enabled)" = 0 ]; then
    uci set nikki.config.profile='file:default.yaml' || exit 1
    uci set nikki.mixin.api_listen='127.0.0.1:9090' || exit 1
    uci set nikki.mixin.dns_direct_nameserver_follow_policy='1' || exit 1
    changed=1
    profile='file:default.yaml'
fi

if [ "$profile" = 'file:default.yaml' ]; then
    if [ "$(uci -q get nikki.mixin.dns_direct_nameserver_follow_policy)" != 1 ]; then
        uci set nikki.mixin.dns_direct_nameserver_follow_policy='1' || exit 1
        changed=1
    fi
    safe_paths=$(uci -q get nikki.procd.env_safe_paths)
    case ":$safe_paths:" in
        *:/var/run/nikki-service-guard:*) ;;
        *)
            uci set "nikki.procd.env_safe_paths=${safe_paths:+$safe_paths:}/var/run/nikki-service-guard" || exit 1
            changed=1
            ;;
    esac
fi

[ "$changed" = 0 ] || uci commit nikki || exit 1
exit 0
