#!/bin/sh /etc/rc.common

START=90
STOP=09
USE_PROCD=1

start_service() {
	/usr/libexec/nikki-service-guard prepare ||
		logger -t nikki-service-guard 'preparation failed; watcher will retry'
	procd_open_instance
	procd_set_param command /usr/bin/ucode -S /usr/share/nikki-service-guard/watch.uc
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger nikki_service_guard
}
